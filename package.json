{
  "name": "extractor",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "dev": "pnpm --filter @extractor/facebook-groups dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:e2e": "pnpm -r --workspace-concurrency=1 test:e2e",
    "lint": "pnpm -r lint",
    "check:no-network": "node scripts/check-no-network.mjs",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm check:no-network && pnpm build"
  }
}
